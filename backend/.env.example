# Backend / FastAPI
APP_NAME=price-dss-backend
ENVIRONMENT=development
DEBUG=true
# Local: sqlite+aiosqlite:///./price_dss_demo.db
# Render entrega postgresql://... y la aplicación lo adapta a asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./price_dss_demo.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
INGESTION_SCHEDULER_ENABLED=true
# En Render, usar false: el cron externo ejecuta scripts/run_due_scraping_schedules.py.
INGESTION_SCHEDULER_EMBEDDED_ENABLED=true
INGESTION_SCHEDULER_POLL_SECONDS=30
INGESTION_SCHEDULER_BATCH_SIZE=10
INGESTION_SCHEDULER_MAX_CONCURRENCY=3
INGESTION_SCHEDULER_LEASE_SECONDS=900
# Requiere PostgreSQL con la extensión pgvector; para SQLite dejarlo en false.
VECTOR_SEARCH_ENABLED=false
VECTOR_EMBEDDING_MODEL=intfloat/multilingual-e5-small
VECTOR_EMBEDDING_DIMENSIONS=384
VECTOR_SEARCH_MIN_SCORE=0.35
