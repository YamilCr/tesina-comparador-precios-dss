# DSS Comparador de Precios - variables de entorno de ejemplo
#
# Este archivo lista todas las variables usadas por el backend y el frontend.
# Para uso local podés copiar:
# - este archivo a .env si ejecutás procesos desde la raíz del repo;
# - backend/.env.example a backend/.env si levantás el backend desde backend/;
# - frontend/.env.example a frontend/.env si levantás Vite desde frontend/.

# Backend / FastAPI
APP_NAME=price-dss-backend
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./backend/price_dss_demo.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend / Vite
# Valores válidos: mock | live
VITE_API_MODE=mock
VITE_API_BASE_URL=http://127.0.0.1:8000
